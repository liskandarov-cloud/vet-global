{
  // Сборка боевого образа: только исходники приложения.
  //
  // Тесты лежат рядом с кодом (*.spec.ts) и в него не входят: в образ им попадать
  // незачем, а их типы (jest) в боевой сборке недоступны — сборка на них падала.
  // Проверка типов самих тестов живёт отдельно, в tsconfig.spec.json, и входит в CI.
  "extends": "./tsconfig.json",
  "exclude": ["node_modules", "dist", "dist-seed", "test", "prisma", "**/*.spec.ts"]
}
