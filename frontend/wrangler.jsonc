{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vethub-web",
  // Обёртка над воркером OpenNext: перенаправление http → https (worker.ts).
  "main": "worker.ts",
  "compatibility_date": "2026-09-12",
  // nodejs_compat нужен рантайму Next; global_fetch_strictly_public заставляет
  // fetch к своему же домену идти через публичный интернет, как в Node.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "a3c248fe2c7245d08ed930e6ef38a117"
    }
  ],
  // Воркер вызывает сам себя, чтобы перестроить устаревшую страницу ISR
  // (очередь в open-next.config.ts). Привязки не наследуются окружениями —
  // у demo своя, на свой воркер.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "vethub-web" }],
  "vars": {
    // Адрес API для браузера. API_INTERNAL_URL здесь намеренно не задан:
    // он имеет смысл только внутри docker-сети, а снаружи серверные запросы
    // по нему молча падают — sitemap остался бы без товаров.
    "NEXT_PUBLIC_API_URL": "https://api.vethub.uz/api",
    "SITE_URL": "https://vethub.uz"
  },
  // Свой домен: Cloudflare сам заводит DNS-записи и сертификаты, зона
  // vethub.uz должна быть в том же аккаунте.
  "routes": [
    { "pattern": "vethub.uz", "custom_domain": true },
    { "pattern": "www.vethub.uz", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  // Демо-стенд для показов: `opennextjs-cloudflare deploy --env demo` после
  // сборки с теми же переменными (NEXT_PUBLIC_* вшиваются при сборке), см.
  // .github/workflows/demo-stand.yml.
  "env": {
    "demo": {
      "name": "vethub-demo",
      "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "bbf439a57bec42afa5a44ec70d96d4d5" }],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "vethub-demo" }],
      "vars": {
        "NEXT_PUBLIC_API_URL": "https://vethub-demo-api.onrender.com/api",
        "SITE_URL": "https://demo.vethub.uz",
        "NEXT_PUBLIC_DEMO": "true"
      },
      "routes": [{ "pattern": "demo.vethub.uz", "custom_domain": true }]
    }
  }
}
